Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Value: true
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Show Arrows: false
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/PoseArray
      Name: AMCL Particles
      Topic:
        # nav2 amcl publishes nav2_msgs/ParticleCloud; particle_relay.py
        # repacks it as PoseArray on this topic
        Value: /particle_cloud_pa
        Depth: 5
        Reliability Policy: Best Effort
      Enabled: true
      Value: true
      Color: 0;255;0
      Arrow Length: 0.15
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL Estimate
      Topic:
        Value: /amcl_pose
        Depth: 5
        Reliability Policy: Best Effort
      Enabled: true
      Value: true
      Covariance:
        Pose Alpha: 0.3
        Position Folder:
          X:
            Value: true
          Y:
            Value: true
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
      Enabled: true
      Value: true
      Line Style: Billions
      Line Width: 0.03
      Color: 255;180;0
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Topic:
        Value: /local_plan
        Depth: 5
        Reliability Policy: Reliable
      Enabled: true
      Value: true
      Line Style: Billions
      Line Width: 0.02
      Color: 0;180;255
    # Humble RViz2 has no Costmap display class - a Map display pointed at
    # the costmap OccupancyGrid topic with the "costmap" color scheme is the
    # standard idiom
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Value: true
      Color Scheme: costmap
      Alpha: 0.4
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Enabled: true
      Value: true
      Color Scheme: costmap
      Alpha: 0.25
      Draw Behind: true
  Global Options:
    Background Color: 230; 230; 230
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 45
      X: -3
      Y: -6
