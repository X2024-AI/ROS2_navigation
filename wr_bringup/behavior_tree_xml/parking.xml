<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="park_demo">
      <!-- 0. fetch the dock pose -->
      <GetDockPose dock_pose="{dock_final_pose}"/>

      <RetryUntilSuccessful num_attempts="3">
        <Fallback name="dock_or_backoff">

          <!-- precision docking: creep approach -> closed-loop micro
               adjustment -> stable verification -->
          <Sequence name="precision_docking">

            <!-- (1) full-speed approach, auto slow-down inside 1.0 m -->
            <DockApproach goal="{dock_final_pose}" bt_xml="{dock_bt}"
                          distance_threshold="1.0" slow_speed="0.0"/>

            <!-- (2) closed-loop micro pose adjustment -->
            <!-- each correction consumes one attempt (AlwaysFailure terminator),
                 so budget for ~2 halvings per axis + yaw dither -->
            <RetryUntilSuccessful num_attempts="12">
              <Fallback name="check_or_correct">
                <CheckPoseTolerance dock="{dock_final_pose}"
                                    pos_tol="0.02" yaw_tol="0.00873"/>
                <Sequence name="corrective_action">
                  <CalcPoseError dock="{dock_final_pose}"
                                 pos_tol="0.02" yaw_tol="0.00873"
                                 correction="{corr}" magnitude="{corr_mag}"/>
                  <MicroAdjustment correction="{corr}" magnitude="{corr_mag}"
                                   pos_tol="0.02" yaw_tol="0.00873" speed="0.05"/>
                  <!-- a completed correction is NOT loop success: fail so the
                       RetryUntilSuccessful re-ticks CheckPoseTolerance for a
                       fresh measurement; only the check passing satisfies it -->
                  <AlwaysFailure/>
                </Sequence>
              </Fallback>
            </RetryUntilSuccessful>

            <!-- (3) stable final verification: 5 consecutive good frames.
                 StableDockVerify is a CONDITION that needs N consecutive
                 in-tolerance ticks - unwrapped, its first FAILURE flowed
                 straight to the back_off branch and one perfect frame could
                 never become five (docked pose reached 3x, rejected in 10 ms,
                 2026-10-22). The retry wrapper re-ticks it at tree rate:
                 60 attempts x 10 Hz = 6 s verification window. -->
            <RetryUntilSuccessful num_attempts="60">
              <StableDockVerify dock="{dock_final_pose}"
                                pos_tol="0.02" yaw_tol="0.00873" hold_frames="5"/>
            </RetryUntilSuccessful>

          </Sequence>

          <!-- docking failed: back off, let the outer retry re-approach -->
          <Sequence name="back_off_for_retry">
            <Backup distance="0.3" speed="0.1"/>
            <AlwaysFailure/>
          </Sequence>

        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>
</root>
